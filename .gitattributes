# Default behavior: auto-detect text files and normalize to LF in repository
* text=auto eol=lf

# Windows Batch & PowerShell scripts MUST retain CRLF in working tree for cmd.exe compatibility
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python and Markdown files always use UTF-8 LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets and media files
*.bin binary
*.onnx binary
*.safetensors binary
*.whl binary
*.exe binary
*.dll binary
*.mp4 binary
*.mkv binary
*.avi binary
*.mov binary
*.mp3 binary
*.wav binary
*.m4a binary
*.webm binary
*.flac binary
*.ogg binary
